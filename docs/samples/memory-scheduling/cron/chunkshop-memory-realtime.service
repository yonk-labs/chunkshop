[Unit]
Description=chunkshop memory — realtime tier (one-shot)
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=app
Group=app
# Set CHUNKSHOP_MEMORY_DSN in /etc/chunkshop/env (chmod 600).
EnvironmentFile=/etc/chunkshop/env
ExecStart=/usr/local/bin/chunkshop ingest --config /etc/chunkshop/memory/realtime.yaml
StandardOutput=journal
StandardError=journal

# Realtime is fast (<1s); a 30s timeout is plenty and stops a stuck run
# from blocking the next tick.
TimeoutStartSec=30s

# Tighten sandboxing — chunkshop doesn't need much.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log
ProtectHome=true
PrivateTmp=true
