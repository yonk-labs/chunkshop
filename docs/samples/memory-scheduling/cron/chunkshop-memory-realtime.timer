[Unit]
Description=chunkshop realtime — every minute

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=5s
# Catch up after downtime: trigger one realtime run on the next start,
# not however many ticks were missed (the realtime cell is idempotent).
Persistent=true

[Install]
WantedBy=timers.target
